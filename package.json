    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.0.1",
    "quill": "^2.0.3",
    "vue": "^3.5.26",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.0.0",
