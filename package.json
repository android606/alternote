{
  "name": "alternote",
  "version": "2.0.0",
  "private": true,
  "description": "Alternote - A modern note-taking app for Nextcloud",
  "license": "AGPL-3.0-only",
  "author": "Andrew Mark",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
